{
  "uid": "holycluster-system",
  "title": "HolyCluster / System overview",
  "description": "Scrape health, source health, spot throughput, client load and background work. No host-level metrics are available.",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "timezone": "browser",
  "refresh": "30s",
  "tags": [
    "HolyCluster",
    "monitoring"
  ],
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {},
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "How to read this dashboard",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "Missing series show **No data**, not zero. Labelled counters appear only after activity; rates need at least two scrapes. Check scrape health before interpreting gaps. A source health value of 0 can also mean disabled (SOTA is disabled by default). Telnet health is aggregate, not per host."
      }
    },
    {
      "type": "table",
      "title": "Scrape target health",
      "description": "0 = scrape failed, 1 = scrape succeeded. No data means no matching target is being scraped.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=~\"api|collector\"}",
          "legendFormat": "{{instance}}",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "range": false,
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "noValue": "No data",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Down",
                  "color": "red"
                },
                "1": {
                  "text": "Up",
                  "color": "green"
                }
              }
            }
          ],
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "stat",
      "title": "Active WebSocket connections",
      "description": "Accepted open connections. No data before the first accepted connection.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(holycluster_api_websocket_active)",
          "legendFormat": "Connections",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "range": false,
          "instant": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "noValue": "No data",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "id": 3,
      "gridPos": {
        "x": 12,
        "y": 3,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Accepted spots and pipeline throughput",
      "description": "Queued is accepted at ingestion; persisted is a successful pipeline result. Other outcomes are on the pipeline dashboard.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(holycluster_collector_spots_total{stage=\"ingest\",result=\"queued\"}[$__rate_interval]))",
          "legendFormat": "Queued",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "range": true,
          "instant": false,
          "format": "time_series"
        },
        {
          "refId": "B",
          "expr": "sum(rate(holycluster_collector_spots_total{stage=\"pipeline\",result=\"success\"}[$__rate_interval]))",
          "legendFormat": "Persisted",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "noValue": "No data",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 4,
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "table",
      "title": "Source health (0 = unhealthy or disabled)",
      "description": "JSON: most recent decoded response. Telnet: at least one connection. Disabled sources remain 0; this does not indicate a scrape failure.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "holycluster_collector_source_up",
          "legendFormat": "{{instance}}",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "range": false,
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "noValue": "No data",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Unhealthy / disabled",
                  "color": "red"
                },
                "1": {
                  "text": "Healthy",
                  "color": "green"
                }
              }
            }
