  "panels": [
    {
      "type": "text",
      "title": "Connectivity",
      "options": {
        "mode": "markdown",
        "content": "User-facing connectivity only. Missing series show **No data**, not zero. Rates need two scrapes. API availability measures scrape success, not public reachability. Subscribers are anonymous open spot subscriptions, not unique users."
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "id": 1
    },
    {
      "type": "stat",
      "title": "API availability",
      "description": "Scrape availability: 1 = all API instances can be scraped. This is not an external reachability probe.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "min(up{job=\"api\"})",
          "legendFormat": "API availability",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "noValue": "No data",
          "color": {
            "mode": "palette-classic"
          },
          "mappings": []
        },
        "overrides": []
      },
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 6,
        "h": 5
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "horizontal",
        "colorMode": "value",
        "graphMode": "none",
        "displayMode": "basic"
      },
      "id": 2
    },
    {
      "type": "stat",
      "title": "Active WebSocket connections",
      "description": "All accepted open WebSockets, including connections without a spot subscription.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(holycluster_api_websocket_active)",
          "legendFormat": "Active WebSocket connections",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
