    {
      "type": "timeseries",
      "title": "Spot broadcast latency",
      "description": "Complete fan-out to both protocols, including recipient eviction.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(holycluster_api_spot_broadcast_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p50",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "instant": false,
          "range": true,
          "format": "time_series"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(holycluster_api_spot_broadcast_duration_seconds_bucket[$__rate_interval])))",
