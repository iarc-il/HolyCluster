{
  "uid": "holycluster-api",
  "title": "HolyCluster / API and client activity",
  "description": "HTTP routes, WebSocket protocols, feature usage and background work.",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "timezone": "browser",
  "refresh": "30s",
  "tags": [
    "HolyCluster",
    "monitoring"
