  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "How to read this dashboard",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "Missing series show **No data**, not zero. Labelled counters appear only after activity; rates need at least two scrapes. Check scrape health before interpreting gaps. A source health value of 0 can also mean disabled (SOTA is disabled by default). Telnet health is aggregate, not per host. HTTP routes are fixed route templates, not raw request paths. History counts are returned records or samples, not requests."
      }
    },
    {
      "type": "timeseries",
      "title": "HTTP requests by route, method and status",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (route, method, status) (rate(holycluster_api_http_requests_total[$__rate_interval]))",
          "legendFormat": "{{method}} {{route}} {{status}}",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "noValue": "No data",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 24,
        "h": 8
      }
    },
