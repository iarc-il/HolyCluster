      "title": "Dropped spots by reason",
      "description": "Includes ingestion rejections and unsuccessful downstream outcomes. Stages are not additive.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (stage, result) (rate(holycluster_collector_spots_total{source!=\"sota\",result!~\"queued|success\"}[$__rate_interval]))",
