    {
      "type": "stat",
      "title": "Duplicate percentage",
      "description": "Telnet duplicates / all telnet ingestion outcomes. No traffic gives No data.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum(rate(holycluster_collector_spots_total{source!~\"pota|sota|wwff\",stage=\"ingest\",result=\"duplicate\"}[$__rate_interval])) / (sum(rate(holycluster_collector_spots_total{source!~\"pota|sota|wwff\",stage=\"ingest\"}[$__rate_interval])) > 0)",
          "legendFormat": "Duplicate percentage",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "noValue": "No data",
          "color": {
            "mode": "palette-classic"
          },
          "mappings": []
        },
        "overrides": []
      },
