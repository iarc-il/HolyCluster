{
  "uid": "holycluster-pipeline",
  "title": "HolyCluster / Spots and sources",
  "description": "Source availability, spot collection and pipeline outcomes, queue and reference refreshes.",
  "schemaVersion": 41,
  "version": 2,
  "editable": false,
  "timezone": "browser",
  "refresh": "30s",
  "tags": [
    "HolyCluster",
    "monitoring"
  ],
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {},
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "Connectivity",
      "type": "link",
      "url": "/d/holycluster-system",
      "targetBlank": false
    },
    {
      "title": "Users",
      "type": "link",
      "url": "/d/holycluster-api",
      "targetBlank": false
    }
  ],
  "panels": [
    {
      "type": "text",
      "title": "Spots and sources",
      "options": {
        "mode": "markdown",
        "content": "SOTA is excluded. Sources use configured names, including individual Telnet sources. Missing series show **No data**, not zero. Rates need two scrapes. Ingestion, enrichment, pipeline and persistence count different events; do not add stages. The last parsed spot age uses a planned metric."
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "id": 1
    },
    {
      "type": "table",
      "title": "Current source availability",
      "description": "Current availability for each configured source. Disabled SOTA is excluded.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "holycluster_collector_source_up{source!=\"sota\"}",
          "legendFormat": "{{source}}",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "noValue": "No data",
          "color": {
            "mode": "palette-classic"
          },
          "mappings": []
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Status"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "Inactive",
                        "color": "red"
                      },
                      "1": {
                        "text": "Active",
                        "color": "green"
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          }
        ]
      },
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 9,
        "h": 5
      },
      "options": {
        "showHeader": true
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true
            },
            "indexByName": {
              "source": 0,
              "Value": 1
            },
            "renameByName": {
              "source": "Source",
              "Value": "Status"
            }
          }
        }
      ],
      "id": 2
    },
    {
      "type": "stat",
      "title": "Incoming spots",
      "description": "All parsed or rejected ingestion outcomes; each ingestion outcome counts once.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(holycluster_collector_spots_total{source!=\"sota\",stage=\"ingest\"}[$__rate_interval]))",
          "legendFormat": "Incoming spots",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: spots/s",
          "min": 0,
          "noValue": "No data",
          "color": {
            "mode": "palette-classic"
          },
          "mappings": []
        },
        "overrides": []
      },
      "gridPos": {
        "x": 9,
        "y": 3,
        "w": 5,
        "h": 5
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "horizontal",
        "colorMode": "value",
        "graphMode": "none",
        "displayMode": "basic"
      },
      "id": 3
    },
    {
      "type": "stat",
      "title": "Completed pipeline",
      "description": "Successful pipeline completions per second; not persistence operation count.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(holycluster_collector_spots_total{source!=\"sota\",stage=\"pipeline\",result=\"success\"}[$__rate_interval]))",
          "legendFormat": "Completed pipeline",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: spots/s",
          "min": 0,
          "noValue": "No data",
          "color": {
            "mode": "palette-classic"
          },
          "mappings": []
        },
        "overrides": []
      },
      "gridPos": {
        "x": 14,
        "y": 3,
        "w": 5,
        "h": 5
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "horizontal",
        "colorMode": "value",
        "graphMode": "none",
        "displayMode": "basic"
      },
      "id": 4
    },
    {
      "type": "stat",
      "title": "Duplicate percentage",
      "description": "Duplicates / all ingestion outcomes. No traffic gives No data.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum(rate(holycluster_collector_spots_total{source!=\"sota\",stage=\"ingest\",result=\"duplicate\"}[$__rate_interval])) / (sum(rate(holycluster_collector_spots_total{source!=\"sota\",stage=\"ingest\"}[$__rate_interval])) > 0)",
          "legendFormat": "Duplicate percentage",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "noValue": "No data",
          "color": {
            "mode": "palette-classic"
          },
          "mappings": []
        },
        "overrides": []
      },
      "gridPos": {
        "x": 19,
        "y": 3,
        "w": 5,
        "h": 5
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "horizontal",
        "colorMode": "value",
        "graphMode": "none",
        "displayMode": "basic"
      },
      "id": 5
    },
    {
      "type": "state-timeline",
      "title": "Source availability timeline",
      "description": "Per configured source and collector instance. Gaps mean no series, not a healthy source.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "holycluster_collector_source_up{source!=\"sota\"}",
          "legendFormat": "{{source}} / {{instance}}",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "instant": false,
          "range": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "noValue": "No data",
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Unavailable",
                  "color": "red"
                },
                "1": {
                  "text": "Available",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "options": {
        "showValue": "never",
        "rowHeight": 0.8,
        "mergeValues": true,
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "id": 6
    },
