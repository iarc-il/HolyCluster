    {
      "type": "timeseries",
      "title": "LoTW / DXpedition refresh health",
      "description": "Attempt, success and error rates are not additive. Refreshes can be idle for a day.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (dataset, result) (rate(holycluster_collector_refresh_total{dataset=~\"lotw|dxpeditions\"}[$__rate_interval]))",
          "legendFormat": "{{dataset}} / {{result}}",
          "datasource": {
            "type": "prometheus",
