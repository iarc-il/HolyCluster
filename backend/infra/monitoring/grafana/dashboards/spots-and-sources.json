    {
      "type": "timeseries",
      "title": "Processing pipeline \u00b7 rates with time lag",
      "description": "Independent event rates: queued \u2192 enrich success \u2192 pipeline success. Queue wait and work cause time lag. This is not an exact transaction funnel; do not subtract stages.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(holycluster_collector_spots_total{source!=\"sota\",stage=\"ingest\",result=\"queued\"}[$__rate_interval]))",
          "legendFormat": "Queued",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "instant": false,
          "range": true,
          "format": "time_series"
        },
        {
          "refId": "B",
          "expr": "sum(rate(holycluster_collector_spots_total{source!=\"sota\",stage=\"enrich\",result=\"success\"}[$__rate_interval]))",
          "legendFormat": "Enrich success",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "instant": false,
          "range": true,
          "format": "time_series"
        },
        {
          "refId": "C",
          "expr": "sum(rate(holycluster_collector_spots_total{source!=\"sota\",stage=\"pipeline\",result=\"success\"}[$__rate_interval]))",
          "legendFormat": "Pipeline success",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "instant": false,
          "range": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: spots/s",
          "min": 0,
          "noValue": "No data",
          "color": {
            "mode": "palette-classic"
          },
          "mappings": []
        },
        "overrides": []
