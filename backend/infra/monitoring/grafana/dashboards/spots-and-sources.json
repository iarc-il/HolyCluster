    {
      "type": "timeseries",
      "title": "Time since last parsed spot by source",
      "description": "Uses the planned last parsed spot timestamp metric. No data means no timestamp is available; it does not mean a healthy or idle source.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(time() - holycluster_collector_source_last_spot_timestamp_seconds{source!=\"sota\"}) and (holycluster_collector_source_last_spot_timestamp_seconds{source!=\"sota\"} > 0)",
          "legendFormat": "{{source}} / {{instance}}",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "instant": false,
          "range": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "noValue": "No data",
