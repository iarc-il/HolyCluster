      "description": "Share of queued (accepted) spots. No accepted traffic gives No data.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum by (source) (rate(holycluster_collector_spots_total{source!=\"sota\",stage=\"ingest\",result=\"queued\"}[$__rate_interval])) / scalar(sum(rate(holycluster_collector_spots_total{source!=\"sota\",stage=\"ingest\",result=\"queued\"}[$__rate_interval])) > 0)",
          "legendFormat": "{{source}}",
          "datasource": {
            "type": "prometheus",
