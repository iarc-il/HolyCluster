      "title": "Pipeline summary",
      "type": "row"
    },
    {
      "type": "stat",
      "title": "Incoming spots",
      "description": "All parsed or rejected ingestion outcomes; each ingestion outcome counts once.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(holycluster_collector_spots_total{source!~\"sota|telnet\",stage=\"ingest\"}[$__rate_interval]))",
          "legendFormat": "Incoming spots",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: spots/s",
          "min": 0,
          "noValue": "No data",
          "color": {
            "mode": "palette-classic"
          },
          "mappings": []
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "horizontal",
        "colorMode": "value",
        "graphMode": "none",
        "displayMode": "basic"
      },
      "id": 3
    },
    {
      "type": "stat",
      "title": "Completed pipeline",
      "description": "Successful pipeline completions per second; not persistence operation count.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(holycluster_collector_spots_total{source!~\"sota|telnet\",stage=\"pipeline\",result=\"success\"}[$__rate_interval]))",
          "legendFormat": "Completed pipeline",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "instant": true,
          "range": false,
          "format": "time_series"
