    {
      "id": 10,
      "type": "table",
      "title": "Current UI / CATServer version combinations",
      "description": "Open spot subscriptions summed across API instances. CATServer none means direct web. Retained zero rows are observed pairs with no active subscriptions, not missing data.",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (ui_version, catserver_version) (holycluster_api_client_version_active)",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "ui_version": 0,
              "catserver_version": 1,
              "Value": 2
            },
            "renameByName": {
              "ui_version": "UI version",
              "catserver_version": "CATServer version (none = direct web)",
              "Value": "Active subscriptions"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "No data",
          "mappings": []
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Active subscriptions"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "min",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Active subscriptions",
            "desc": true
          }
        ]
      }
    },
    {
      "type": "timeseries",
      "title": "Version reporting coverage",
      "description": "Both valid fields includes development UI and direct web CAT none. Legacy / unreported misses either field. Invalid/other may leave a gap; these two series are not a full partition.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (sum(holycluster_api_client_version_active{ui_version!~\"not_reported|invalid|other\",catserver_version!~\"not_reported|invalid|other\"}) or (0 * sum(holycluster_api_client_version_active))) / (sum(holycluster_api_client_version_active) > 0)",
          "legendFormat": "Both valid fields",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "instant": false,
          "range": true,
          "format": "time_series"
        },
        {
          "refId": "B",
          "expr": "100 * (sum(holycluster_api_client_version_active{ui_version=\"not_reported\"} or holycluster_api_client_version_active{catserver_version=\"not_reported\"}) or (0 * sum(holycluster_api_client_version_active))) / (sum(holycluster_api_client_version_active) > 0)",
          "legendFormat": "Legacy / unreported",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "instant": false,
          "range": true,
          "format": "time_series"
        }
