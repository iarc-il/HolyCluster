    {
      "type": "text",
      "title": "Users",
      "options": {
        "mode": "markdown",
        "content": "All counts are anonymous subscriptions, connections or requests \u2014 **never unique users**. Direct web means CAT version `none`; unreported CAT versions cannot be classified. Version adoption uses active subscriptions, not report events. Missing series show **No data**, not zero. Rates need two scrapes."
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "id": 1
    },
    {
      "type": "stat",
      "title": "Active spot subscribers",
      "description": "Anonymous open spot subscriptions, not unique users.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(holycluster_api_client_version_active)",
          "legendFormat": "Active spot subscribers",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
