      "title": "UI refresh blockers and mismatches",
      "description": "Blocked evaluations by blocker and automatic navigation attempts that loaded the old entry.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (event, blocker) (rate(holycluster_api_ui_refresh_events_total{event=~\"blocked|target_mismatch\"}[$__rate_interval]))",
          "legendFormat": "{{event}} \u00b7 {{blocker}}",
