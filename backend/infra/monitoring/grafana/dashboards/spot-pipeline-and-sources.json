    {
      "type": "timeseries",
      "title": "Queue utilization",
      "description": "Per collector instance. Capacity is guarded against zero.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "holycluster_collector_queue_depth / clamp_min(holycluster_collector_queue_capacity, 1)",
          "legendFormat": "{{instance}}",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "range": true,
          "instant": false,
          "format": "time_series"
