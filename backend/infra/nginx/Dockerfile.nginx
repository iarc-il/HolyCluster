# Use official NGINX image
FROM nginx:stable-bookworm

# Install envsubst for variable substitution, network utilities
RUN apt-get update && apt-get install -y gettext-base net-tools iputils-ping dnsutils procps && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /etc/nginx

# Copy the template NGINX config
COPY nginx.conf.template .

# Expose HTTP and HTTPS ports
EXPOSE 80 443 9999

# Use envsubst to replace environment variables at container start.
# When DOMAIN_ALT is set, also render the alternate-domain server block into conf.d.
# Keep this in sync with the nginx service command in docker-compose.yml.
CMD envsubst '${DOMAIN} ${DOMAIN_ALT}' < /etc/nginx/nginx.conf.template > /etc/nginx/nginx.conf && \
    { [ -n "$DOMAIN_ALT" ] && envsubst '${DOMAIN_ALT}' < /etc/nginx/nginx-alt.conf.template > /etc/nginx/conf.d/alt.conf || true; } && \
    nginx -g 'daemon off;'

