# Backend Application Configuration
# Copy this file to .env and fill in the values

# general
LOG_DIR=/var/log/holy
COMPOSE_PROJECT_NAME=holycluster-backend-dev

# Sentry (optional DSN; environment and release are required for every process)
# Use the holycluster-backend DSN for both dev and prod.
# Set SENTRY_ENVIRONMENT to dev or prod for each deployment.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=

# postgres
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB_NAME=holy_cluster
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_HOST_LOCAL=localhost
POSTGRES_PORT_LOCAL=15432

# valkey
VALKEY_PASSWORD=
VALKEY_HOST=valkey
VALKEY_PORT=6379
VALKEY_HOST_LOCAL=localhost
VALKEY_PORT_LOCAL=6379
VALKEY_DB=0
VALKEY_SPOT_EXPIRATION=60
VALKEY_GEO_EXPIRATION=3600

# collectors
USERNAME_FOR_TELNET_CLUSTERS=
QRZ_USER=
QRZ_PASSWORD=
QRZ_API_KEY=
QRZ_SESSION_KEY_REFRESH=3600

# API
# CATSERVER_MSI_DIR is the CATServer release root containing latest.json and artifacts/.
UI_DIST_PATH=
CATSERVER_MSI_DIR=

# SSL (for setup.sh)
DOMAIN=holycluster.example.com
EMAIL=admin@example.com
PROXY_NETWORK=holycluster-proxy

# Optional second domain served alongside DOMAIN, each with its OWN cert. Leave
# empty to disable. When set, nginx renders an extra HTTPS server block for it
# (infra/nginx/nginx-alt.conf.template) and expects a cert at
# /etc/letsencrypt/live/$DOMAIN_ALT/. Issue/renew it on the box with certbot via
# webroot http-01 (same as DOMAIN) even when the name is behind the Cloudflare proxy,
# as long as the zone has Always-Use-HTTPS off. No Cloudflare credential on the box.
DOMAIN_ALT=

# Monitor
INSTANCE_NAME=
WS_URL=ws://api:8000/ws
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

DEBUG=false
