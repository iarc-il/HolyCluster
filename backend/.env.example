# Backend Application Configuration
# Copy this file to .env and fill in the values

# general
LOG_DIR=/var/log/holy

# postgres
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB_NAME=holy_cluster
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_HOST_LOCAL=localhost
POSTGRES_PORT_LOCAL=15432

# valkey
VALKEY_PASSWORD=
VALKEY_HOST=valkey
VALKEY_PORT=6379
VALKEY_HOST_LOCAL=localhost
VALKEY_PORT_LOCAL=6379
VALKEY_DB=0
VALKEY_SPOT_EXPIRATION=60
VALKEY_GEO_EXPIRATION=3600

# collectors
USERNAME_FOR_TELNET_CLUSTERS=
QRZ_USER=
QRZ_PASSWORD=
QRZ_API_KEY=
QRZ_SESSION_KEY_REFRESH=3600

# API
UI_DIST_PATH=
CATSERVER_MSI_DIR=

# SSL (for setup.sh)
DOMAIN=holycluster.example.com
EMAIL=admin@example.com

# Optional second domain served alongside DOMAIN, each with its OWN cert. Leave
# empty to disable. When set, nginx renders an extra HTTPS server block for it
# (infra/nginx/nginx-alt.conf.template) and expects a cert at
# /etc/letsencrypt/live/$DOMAIN_ALT/. Issue via DNS-01 (needs CLOUDFLARE_API_TOKEN).
DOMAIN_ALT=

# Cloudflare API token (Zone:DNS:Edit, single zone) for certbot DNS-01 issuance and
# renewal of a proxied DOMAIN_ALT. http-01 is unreliable behind the Cloudflare proxy;
# DNS-01 works whether the proxy is on or off. The certbot container writes this to
# /root/.secrets/cloudflare.ini at startup. Never log the value.
CLOUDFLARE_API_TOKEN=

# Monitor
INSTANCE_NAME=
WS_URL=ws://api:8000/ws
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

DEBUG=false
