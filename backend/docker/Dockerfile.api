FROM rust:1.98.1-slim-bookworm AS artifact-validator
WORKDIR /validator
COPY shared/artifact-validator/ ./
RUN cargo build --release --locked --bin holy-artifact-validator

FROM python:3.13-slim-bookworm
COPY --from=artifact-validator /validator/target/release/holy-artifact-validator /usr/local/bin/holy-artifact-validator

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

# Install dependencies first (cached layer)
RUN --mount=from=ghcr.io/astral-sh/uv,source=/uv,target=/bin/uv \
    --mount=type=cache,target=/root/.cache/uv \
    --mount=type=bind,source=uv.lock,target=uv.lock \
    --mount=type=bind,source=pyproject.toml,target=pyproject.toml \
    --mount=type=bind,source=api/pyproject.toml,target=api/pyproject.toml \
    --mount=type=bind,source=collectors/pyproject.toml,target=collectors/pyproject.toml \
    --mount=type=bind,source=shared/pyproject.toml,target=shared/pyproject.toml \
    uv sync --frozen --no-install-workspace

# Copy workspace members
COPY api/ ./api/
COPY shared/ ./shared/
# Copy other members for workspace validity
COPY collectors/ ./collectors/
COPY pyproject.toml uv.lock ./

# Install project non-editably
RUN --mount=from=ghcr.io/astral-sh/uv,source=/uv,target=/bin/uv \
    --mount=type=cache,target=/root/.cache/uv \
    uv sync --locked --no-editable --package api

ENV PATH="/app/.venv/bin:$PATH"

EXPOSE 8000

CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]


