#!/usr/bin/env bash

set -euo pipefail

script_dir=$(dirname "$(realpath "$0")")
# shellcheck disable=SC1091
source "$script_dir/agent-common"
agent_init "$script_dir/.."

print_task() {
    local task=$1 status branch worktree base base_branch session window live dirty commits divergence
    status=$(agent_state_get "$task" status) || agent_die "Unknown task: $task"
    branch=$(agent_state_get "$task" branch)
    worktree=$(agent_state_get "$task" worktree)
    base=$(agent_state_get "$task" base)
    base_branch=$(agent_state_get "$task" base_branch)
    session=$(agent_state_get "$task" session)
    window=$(agent_state_get "$task" window)
    live=dead
    agent_window_exists "$session" "$window" && live=live
    dirty=missing
    commits=missing
    divergence='missing'
    if [[ -d $worktree ]]; then
        mapfile -t changes < <(git -C "$worktree" status --porcelain)
        dirty=${#changes[@]}
    fi
    if git -C "$AGENT_REPO" show-ref --verify --quiet "refs/heads/$branch"; then
        commits=$(git -C "$AGENT_REPO" rev-list --count "$base..$branch")
        divergence=$(git -C "$AGENT_REPO" rev-list --left-right --count "$base_branch...$branch" | tr '\t' '/')
    fi
    printf '%-20s %-10s %-5s %-7s %-7s %-9s %s\n' \
        "$task" "$status" "$live" "$dirty" "$commits" "$divergence" "$branch"
    if [[ $status == blocked ]]; then
        printf 'Blocker: %s\n' "$(agent_state_get "$task" blocker)"
    fi
    if [[ $status == integration-* ]]; then
        printf 'Staging: %s\n' "$(agent_state_get "$task" staging_worktree)"
    fi
}

printf '%-20s %-10s %-5s %-7s %-7s %-9s %s\n' \
    TASK STATUS AGENT DIRTY COMMITS BASE/AGENT BRANCH
if [[ $# -eq 1 ]]; then
    agent_validate_task "$1"
    print_task "$1"
elif [[ $# -eq 0 ]]; then
    shopt -s nullglob
    states=("$AGENT_STATE_ROOT"/states/*.tsv)
    for state in "${states[@]}"; do
        task=${state##*/}
        print_task "${task%.tsv}"
    done
else
    printf 'Usage: %s [task]\n' "${0##*/}" >&2
    exit 2
fi
