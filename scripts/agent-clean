#!/usr/bin/env bash

set -euo pipefail

script_dir=$(dirname "$(realpath "$0")")
# shellcheck disable=SC1091
source "$script_dir/agent-common"
agent_init "$script_dir/.."

[[ $# -eq 1 ]] || { printf 'Usage: %s <task>\n' "${0##*/}" >&2; exit 2; }
task=$1
agent_validate_task "$task"
state_file=$(agent_state_file "$task")
[[ -f $state_file ]] || agent_die "Unknown task: $task"
[[ $(agent_state_get "$task" status) == integrated ]] || agent_die "Task is not integrated: $task"

branch=$(agent_state_get "$task" branch)
base_branch=$(agent_state_get "$task" base_branch)
worktree=$(agent_state_get "$task" worktree)
session=$(agent_state_get "$task" session)
window=$(agent_state_get "$task" window)
review_window=$(agent_state_get "$task" review_window 2>/dev/null || true)

if [[ -n $review_window ]] && agent_window_exists "$session" "$review_window"; then
    tmux kill-window -t "$session:$review_window"
fi
if agent_window_exists "$session" "$window"; then
    tmux kill-window -t "$session:$window" 2>/dev/null || true
fi
[[ -d $worktree ]] || agent_die "Worktree does not exist: $worktree"
[[ -z $(git -C "$worktree" status --porcelain) ]] || agent_die "Worktree is dirty: $worktree"
branch_tip=$(git -C "$AGENT_REPO" rev-parse "$branch")
mapfile -t unintegrated < <(git -C "$AGENT_REPO" cherry "$base_branch" "$branch_tip" | while read -r mark commit; do
    [[ $mark == + ]] && printf '%s\n' "$commit"
done)
(( ${#unintegrated[@]} == 0 )) || agent_die "Branch contains commits not integrated into $base_branch"
[[ $(git -C "$AGENT_REPO" rev-parse "$branch") == "$branch_tip" ]] || agent_die 'Branch changed during cleanup'
git -C "$AGENT_REPO" worktree remove "$worktree"
git -C "$AGENT_REPO" update-ref -d "refs/heads/$branch" "$branch_tip"
mkdir -p "$AGENT_STATE_ROOT/archive"
mv "$state_file" "$AGENT_STATE_ROOT/archive/$task.tsv"
printf 'Cleaned task %s\n' "$task"
