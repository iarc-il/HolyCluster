#!/usr/bin/env bash

set -euo pipefail

script_dir=$(dirname "$(realpath "$0")")
# shellcheck disable=SC1091
source "$script_dir/agent-common"

usage() {
    printf 'Usage: %s [--dry-run | --resume] <task-brief.md>\n' "${0##*/}"
}

mode=start
case ${1:-} in
    --help|-h)
        usage
        exit 0
        ;;
    --dry-run)
        mode=dry-run
        shift
        ;;
    --resume)
        mode=resume
        shift
        ;;
esac

if [[ $# -ne 1 ]]; then
    usage >&2
    exit 2
fi

[[ -f $1 ]] || agent_die "Task brief does not exist: $1"
task_file=$(realpath "$1")
task=$(agent_task_from_file "$task_file")
agent_init "$script_dir/.."

base=$(git -C "$AGENT_REPO" rev-parse HEAD)
base_branch=$(git -C "$AGENT_REPO" branch --show-current)
[[ -n $base_branch ]] || agent_die 'Start tasks from a named integration branch'
repo_name=${AGENT_REPO##*/}
branch="agent/$task"
worktree_root=${AGENT_WORKTREE_ROOT:-"$(dirname "$AGENT_REPO")/$repo_name-worktrees"}
worktree="$worktree_root/$task"
tmux_session=${AGENT_TMUX_SESSION:-agents}

rollback_launch() {
    local reason=$1 tip commits
    agent_state_put "$task" status launch-failed
    commits=$(git -C "$AGENT_REPO" rev-list --count "$base..$branch")
    if [[ -z $(git -C "$worktree" status --porcelain) && $commits -eq 0 ]]; then
        tip=$(git -C "$AGENT_REPO" rev-parse "$branch")
        git -C "$AGENT_REPO" worktree remove "$worktree"
        git -C "$AGENT_REPO" update-ref -d "refs/heads/$branch" "$tip"
        rm -f "$(agent_state_file "$task")"
    else
        printf 'Failed launch work was preserved at %s\n' "$worktree" >&2
    fi
    agent_die "$reason"
}

mapfile -t requirements < <(agent_read_list requires "$task_file")
mapfile -t setup_commands < <(agent_read_list setup "$task_file")
for required in "${requirements[@]}"; do
    if ! git -C "$AGENT_REPO" cat-file -e "HEAD:$required" 2>/dev/null; then
        agent_die "Cannot start task: $required is not committed in HEAD"
    fi
    if ! git -C "$AGENT_REPO" diff --quiet HEAD -- "$required"; then
        agent_die "Cannot start task: $required has uncommitted changes"
    fi
done
if [[ -f $AGENT_REPO/opencode.json ]] && \
    ! git -C "$AGENT_REPO" cat-file -e HEAD:opencode.json 2>/dev/null; then
    printf 'Warning: untracked opencode.json will not be available in the worktree\n' >&2
fi

if [[ $mode == resume ]]; then
    git -C "$AGENT_REPO" show-ref --verify --quiet "refs/heads/$branch" || agent_die "Branch does not exist: $branch"
    [[ -d $worktree ]] || agent_die "Worktree does not exist: $worktree"
    if [[ ! -f $(agent_state_file "$task") ]]; then
        base=$(git -C "$AGENT_REPO" merge-base "$base_branch" "$branch")
        agent_write_state "$task" \
            status active branch "$branch" worktree "$worktree" base "$base" \
            base_branch "$base_branch" session "$tmux_session" window "$task" task_file "$task_file"
    fi
    if agent_window_exists "$tmux_session" "$task"; then
        agent_state_update "$task" status active blocker ''
        agent_print_location "$task" "$branch" "$worktree" "$tmux_session"
        exit 0
    fi
    if ! agent_launch_opencode "$tmux_session" "$task" "$worktree" "$task_file"; then
        agent_state_put "$task" status launch-failed
        exit 1
    fi
    agent_state_update "$task" status active blocker ''
    agent_print_location "$task" "$branch" "$worktree" "$tmux_session"
    exit 0
fi

if git -C "$AGENT_REPO" show-ref --verify --quiet "refs/heads/$branch"; then
    agent_die "Branch already exists: $branch; use --resume to restart it"
fi
[[ ! -e $worktree ]] || agent_die "Worktree path already exists: $worktree"
agent_window_exists "$tmux_session" "$task" && agent_die "Tmux window already exists: $tmux_session:$task"

if [[ $mode == dry-run ]]; then
    printf 'Action:   create worktree and launch OpenCode\n'
    agent_print_location "$task" "$branch" "$worktree" "$tmux_session"
    exit 0
fi

mkdir -p "$worktree_root"
git -C "$AGENT_REPO" worktree add -b "$branch" "$worktree"
agent_write_state "$task" \
    status starting branch "$branch" worktree "$worktree" base "$base" \
    base_branch "$base_branch" session "$tmux_session" window "$task" task_file "$task_file"
for command in "${setup_commands[@]}"; do
    printf '$ %s\n' "$command"
    if ! (cd "$worktree" && bash -lc "$command"); then
        rollback_launch "Worktree setup failed: $command"
    fi
done
if ! agent_launch_opencode "$tmux_session" "$task" "$worktree" "$task_file"; then
    rollback_launch 'OpenCode launch failed'
fi

agent_write_state "$task" \
    status active branch "$branch" worktree "$worktree" base "$base" \
    base_branch "$base_branch" session "$tmux_session" window "$task" task_file "$task_file"
agent_print_location "$task" "$branch" "$worktree" "$tmux_session"
