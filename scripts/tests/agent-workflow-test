#!/usr/bin/env bash

set -euo pipefail

source_repo=$(git rev-parse --show-toplevel)
test_root=$(mktemp -d)
repo="$test_root/repo"
worktrees="$test_root/worktrees"
fake_bin="$test_root/bin"
tmux_session="agent-workflow-test-$$"

cleanup() {
    tmux kill-session -t "$tmux_session" 2>/dev/null || true
    rm -rf "$test_root"
}
trap cleanup EXIT

mkdir -p "$repo/scripts/tests" "$repo/.agent-tasks/ready" "$fake_bin"
cp "$source_repo"/scripts/agent-* "$repo/scripts/"
cp "$source_repo/scripts/tests/agent-workflow-test" "$repo/scripts/tests/"

printf '%s\n' \
    '#!/usr/bin/env bash' \
    'if [[ $* == *DIRTY_LAUNCH* ]]; then printf dirty >launch-artifact; exit 13; fi' \
    '[[ $* != *FAIL_LAUNCH* ]] || exit 12' \
    'sleep 300' >"$fake_bin/opencode"
chmod +x "$fake_bin/opencode" "$repo"/scripts/agent-*

printf '%s\n' 'initial' >"$repo/app.txt"
printf '%s\n' \
    '---' \
    'id: example' \
    'status: ready' \
    'requires:' \
    '  - app.txt' \
    'files:' \
    '  - app.txt' \
    'setup:' \
    '  - test -f app.txt' \
    'verify:' \
    '  - test -f app.txt' \
    '---' \
    '' \
    '# Update app' \
    '' \
    'Change app.txt.' >"$repo/.agent-tasks/ready/example.md"
for ((line = 0; line < 800; line += 1)); do
    printf 'Additional review context line %04d: verify behavior without weakening assertions.\n' "$line" \
        >>"$repo/.agent-tasks/ready/example.md"
done
printf '%s\n' \
    '---' \
    'requires:' \
    '  - missing.txt' \
    'files:' \
    '  - app.txt' \
    'verify:' \
    '  - test -f app.txt' \
    '---' \
    '# Missing prerequisite' >"$repo/.agent-tasks/ready/missing.md"
printf '%s\n' \
    '---' \
    'requires:' \
    '  - app.txt' \
    'files:' \
    '  - app.txt' \
    'verify:' \
    '  - test -f app.txt' \
    '---' \
    '# FAIL_LAUNCH' >"$repo/.agent-tasks/ready/failure.md"
printf '%s\n' \
    '---' \
    'requires:' \
    '  - app.txt' \
    'files:' \
    '  - app.txt' \
    'verify:' \
    '  - test -f app.txt' \
    '---' \
    '# DIRTY_LAUNCH' >"$repo/.agent-tasks/ready/dirty-failure.md"
printf '%s\n' \
    '---' \
    'requires:' \
    '  - app.txt' \
    'files:' \
    '  - app.txt' \
    'verify:' \
    '  - test -f app.txt' \
    '---' \
    '# Cancel task' >"$repo/.agent-tasks/ready/cancel.md"
printf '%s\n' \
    '---' \
    'requires:' \
    '  - app.txt' \
    'files:' \
    '  - app.txt' \
    'verify:' \
    "  - 'if [[ \${AGENT_INTEGRATING:-} == 1 ]]; then touch generated; fi'" \
    '---' \
    '# Mutating integration verification' >"$repo/.agent-tasks/ready/mutating.md"
printf '%s\n' \
    '---' \
    'requires:' \
    '  - app.txt' \
    'files:' \
    '  - app.txt' \
    'verify:' \
    '  - test -f app.txt' \
    '---' \
    '# Conflicting rebase' >"$repo/.agent-tasks/ready/conflict.md"

git -C "$repo" init -q -b main
git -C "$repo" add .
git -C "$repo" -c user.name=Test -c user.email=test@example.com commit -qm 'Initialize test repository'

export PATH="$fake_bin:$PATH"
export AGENT_WORKTREE_ROOT="$worktrees"
export AGENT_TMUX_SESSION="$tmux_session"

if "$repo/scripts/agent-start" "$repo/.agent-tasks/ready/missing.md" 2>/dev/null; then
    printf 'Missing prerequisite was accepted\n' >&2
    exit 1
fi
if "$repo/scripts/agent-start" "$repo/.agent-tasks/ready/failure.md" 2>/dev/null; then
    printf 'Failed OpenCode launch was accepted\n' >&2
    exit 1
fi
if git -C "$repo" show-ref --verify --quiet refs/heads/agent/failure || [[ -e $worktrees/failure ]]; then
    printf 'Failed launch left git resources behind\n' >&2
    exit 1
fi
if "$repo/scripts/agent-start" "$repo/.agent-tasks/ready/dirty-failure.md" 2>/dev/null; then
    printf 'Dirty failed OpenCode launch was accepted\n' >&2
    exit 1
fi
if ! git -C "$repo" show-ref --verify --quiet refs/heads/agent/dirty-failure || \
    [[ ! -f $worktrees/dirty-failure/launch-artifact ]]; then
    printf 'Dirty failed launch was not preserved\n' >&2
    exit 1
fi
output=$("$repo/scripts/agent-status" dirty-failure)
[[ $output == *launch-failed* ]]

"$repo/scripts/agent-start" "$repo/.agent-tasks/ready/cancel.md" >/dev/null
"$repo/scripts/agent-cancel" --yes cancel
if git -C "$repo" show-ref --verify --quiet refs/heads/agent/cancel || [[ -e $worktrees/cancel ]]; then
    printf 'Cancelled task left git resources behind\n' >&2
    exit 1
fi

"$repo/scripts/agent-start" "$repo/.agent-tasks/ready/mutating.md" >/dev/null
printf '%s\n' 'mutating change' >"$worktrees/mutating/app.txt"
git -C "$worktrees/mutating" add app.txt
git -C "$worktrees/mutating" -c user.name=Test -c user.email=test@example.com commit -qm 'Add mutating verification change'
"$repo/scripts/agent-check" mutating >/dev/null
"$repo/scripts/agent-finish" mutating --ready >/dev/null
"$repo/scripts/agent-review" --no-launch mutating >/dev/null
"$repo/scripts/agent-review" --approve mutating >/dev/null
main_before=$(git -C "$repo" rev-parse HEAD)
if "$repo/scripts/agent-integrate" --yes mutating 2>/dev/null; then
    printf 'Mutating rebased verification was integrated\n' >&2
    exit 1
fi
[[ $(git -C "$repo" rev-parse HEAD) == "$main_before" ]]
output=$("$repo/scripts/agent-status" mutating)
[[ $output == *integration-failed* ]]

"$repo/scripts/agent-start" "$repo/.agent-tasks/ready/conflict.md" >/dev/null
printf '%s\n' 'agent conflict' >"$worktrees/conflict/app.txt"
git -C "$worktrees/conflict" add app.txt
git -C "$worktrees/conflict" -c user.name=Test -c user.email=test@example.com commit -qm 'Change app in agent branch'
"$repo/scripts/agent-check" conflict >/dev/null
"$repo/scripts/agent-finish" conflict --ready >/dev/null
"$repo/scripts/agent-review" --no-launch conflict >/dev/null
"$repo/scripts/agent-review" --approve conflict >/dev/null
printf '%s\n' 'upstream conflict' >"$repo/app.txt"
git -C "$repo" add app.txt
git -C "$repo" -c user.name=Test -c user.email=test@example.com commit -qm 'Change app upstream'
if "$repo/scripts/agent-integrate" --yes conflict 2>/dev/null; then
    printf 'Conflicting rebase unexpectedly succeeded\n' >&2
    exit 1
fi
git -C "$worktrees/conflict" rebase --abort
"$repo/scripts/agent-check" conflict >/dev/null

output=$("$repo/scripts/agent-start" --dry-run "$repo/.agent-tasks/ready/example.md")
[[ $output == *agent/example* ]]
if git -C "$repo" show-ref --verify --quiet refs/heads/agent/example; then
    printf 'Dry-run created a branch\n' >&2
    exit 1
fi

"$repo/scripts/agent-start" "$repo/.agent-tasks/ready/example.md"
git -C "$repo" show-ref --verify --quiet refs/heads/agent/example
tmux has-session -t "$tmux_session"

output=$("$repo/scripts/agent-status" example)
[[ $output == *active* ]]
"$repo/scripts/agent-finish" example --blocked 'Waiting for a prerequisite'
output=$("$repo/scripts/agent-status" example)
[[ $output == *blocked* ]]
"$repo/scripts/agent-start" --resume "$repo/.agent-tasks/ready/example.md"

example_base=$(git -C "$repo" rev-parse HEAD)
printf '%s\n' 'changed once' >"$worktrees/example/app.txt"
if "$repo/scripts/agent-check" example 2>/dev/null; then
    printf 'Verification accepted an uncommitted worktree\n' >&2
    exit 1
fi
git -C "$worktrees/example" add app.txt
git -C "$worktrees/example" -c user.name=Test -c user.email=test@example.com commit -qm 'Start updating app'
printf '%s\n' 'changed' >"$worktrees/example/app.txt"
mkdir -p "$worktrees/example/tests"
printf '%s\n' 'updated behavior test' >"$worktrees/example/tests/app.test"
git -C "$worktrees/example" add app.txt tests/app.test
git -C "$worktrees/example" -c user.name=Test -c user.email=test@example.com commit -qm 'Finish updating app'

"$repo/scripts/agent-check" example
"$repo/scripts/agent-finish" example --ready
output=$("$repo/scripts/agent-status" example)
[[ $output == *review* ]]
if "$repo/scripts/agent-integrate" --yes example 2>/dev/null; then
    printf 'Integration accepted an unapproved review\n' >&2
    exit 1
fi
output=$("$repo/scripts/agent-review" --no-launch example)
[[ $output == *'Start updating app'* && $output == *'Finish updating app'* ]]
"$repo/scripts/agent-review" example >/dev/null
windows=$(tmux list-windows -t "$tmux_session" -F '#{window_name}')
[[ $windows == *review-example* ]]
"$repo/scripts/agent-review" --approve example
printf '%s\n' 'upstream' >"$repo/upstream.txt"
git -C "$repo" add upstream.txt
git -C "$repo" -c user.name=Test -c user.email=test@example.com commit -qm 'Advance integration branch'
upstream_tip=$(git -C "$repo" rev-parse HEAD)
original_app=$(<"$repo/app.txt")
printf '%s\n' 'tracked integration dirt' >"$repo/app.txt"
if "$repo/scripts/agent-integrate" --yes example 2>/dev/null; then
    printf 'Integration accepted a dirty tracked non-script path\n' >&2
    exit 1
fi
printf '%s\n' "$original_app" >"$repo/app.txt"
printf '%s\n' 'untracked integration file' >"$repo/unrelated.txt"
printf '%s\n' 'local workflow edit' >"$repo/scripts/local-only"
"$repo/scripts/agent-integrate" --yes example
[[ $(git -C "$repo" rev-parse HEAD) == "$upstream_tip" ]]
output=$("$repo/scripts/agent-status" example)
[[ $output == *review* ]]
output=$("$repo/scripts/agent-review" --no-launch example)
[[ $output == *'Start updating app'* && $output == *'Finish updating app'* ]]
"$repo/scripts/agent-review" --approve example
"$repo/scripts/agent-integrate" --yes example
[[ $(<"$repo/scripts/local-only") == 'local workflow edit' ]]
[[ $(<"$repo/unrelated.txt") == 'untracked integration file' ]]
[[ $(<"$repo/app.txt") == changed ]]
[[ $(<"$repo/tests/app.test") == 'updated behavior test' ]]
[[ $(git -C "$repo" rev-list --count "$example_base..main") == 3 ]]
output=$("$repo/scripts/agent-status" example)
[[ $output == *integrated* ]]
"$repo/scripts/agent-clean" example

if git -C "$repo" show-ref --verify --quiet refs/heads/agent/example; then
    printf 'Cleanup left the agent branch behind\n' >&2
    exit 1
fi

printf 'Agent workflow test passed\n'
