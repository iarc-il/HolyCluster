#!/usr/bin/env bash

set -euo pipefail

script_dir=$(dirname "$(realpath "$0")")
# shellcheck disable=SC1091
source "$script_dir/agent-common"
agent_init "$script_dir/.."

usage() {
    printf 'Usage: %s [--yes] <task>\n' "${0##*/}"
}

approved=false
if [[ ${1:-} == --yes ]]; then
    approved=true
    shift
fi
[[ $# -eq 1 ]] || { usage >&2; exit 2; }
task=$1
agent_validate_task "$task"
[[ -f $(agent_state_file "$task") ]] || agent_die "Unknown task: $task"
[[ $(agent_state_get "$task" status) == review ]] || agent_die "Task is not ready for integration: $task"
[[ $(agent_state_get "$task" review 2>/dev/null || true) == approved ]] || agent_die "Review is not approved: $task"

branch=$(agent_state_get "$task" branch)
base=$(agent_state_get "$task" base)
base_branch=$(agent_state_get "$task" base_branch)
worktree=$(agent_state_get "$task" worktree)
session=$(agent_state_get "$task" session)
window=$(agent_state_get "$task" window)
review_window=$(agent_state_get "$task" review_window 2>/dev/null || true)
reviewed_commit=$(agent_state_get "$task" reviewed_commit)
current_branch=$(git -C "$AGENT_REPO" branch --show-current)
[[ $current_branch == "$base_branch" ]] || agent_die "Run integration from $base_branch, not $current_branch"
[[ -z $(git -C "$AGENT_REPO" status --porcelain) ]] || agent_die 'Integration checkout is not clean'
[[ -z $(git -C "$worktree" status --porcelain) ]] || agent_die "Task worktree is not clean: $worktree"
[[ $(git -C "$worktree" rev-parse "$branch") == "$reviewed_commit" ]] || agent_die 'Branch changed after review approval'
mapfile -t commits < <(git -C "$AGENT_REPO" rev-list --reverse "$base..$reviewed_commit")
(( ${#commits[@]} )) || agent_die "Task has no commits: $task"

printf 'Task: %s\nBranch: %s\nCommits:\n' "$task" "$branch"
git -C "$AGENT_REPO" log --oneline "$base..$reviewed_commit"
if [[ $approved == false ]]; then
    read -r -p "Rebase $branch onto $base_branch and advance $base_branch? [y/N] " response
    [[ $response == y || $response == Y || $response == yes || $response == YES ]] || agent_die 'Integration cancelled'
fi

if [[ -n $review_window ]] && agent_window_exists "$session" "$review_window"; then
    tmux kill-window -t "$session:$review_window"
fi
if agent_window_exists "$session" "$window"; then
    tmux kill-window -t "$session:$window" 2>/dev/null || true
fi

"$script_dir/agent-check" "$task"
verified_commit=$(agent_state_get "$task" verified_commit)
[[ $verified_commit == "$reviewed_commit" ]] || agent_die 'Reviewed commit did not pass final verification'
[[ $(git -C "$worktree" rev-parse "$branch") == "$reviewed_commit" ]] || agent_die 'Branch changed during final verification'

integration_base=$(git -C "$AGENT_REPO" rev-parse "$base_branch")
if [[ $base != "$integration_base" ]]; then
    agent_state_update "$task" \
        status rebasing base "$integration_base" pre_rebase_base "$base" \
        pre_rebase_commit "$reviewed_commit" \
        integration_base "$integration_base" review pending reviewed_commit ''
    if ! git -C "$worktree" rebase --reapply-cherry-picks --empty=keep "$base_branch"; then
        agent_state_put "$task" status integration-conflict
        agent_die "Rebase conflict preserved at $worktree"
    fi

    rebased_commit=$(git -C "$worktree" rev-parse "$branch")
    agent_state_put "$task" rebased_commit "$rebased_commit"
    if ! AGENT_INTEGRATING=1 "$script_dir/agent-check" "$task"; then
        agent_state_put "$task" status integration-failed
        agent_die "Rebased verification failed at $worktree"
    fi
    agent_state_update "$task" status review review pending reviewed_commit ''
    printf 'Rebased %s onto %s and verified it at %s\n' "$branch" "$base_branch" "$rebased_commit"
    printf 'Review and approve the rebased commit before running integration again\n'
    exit 0
fi

if ! AGENT_INTEGRATING=1 "$script_dir/agent-check" "$task"; then
    agent_state_put "$task" status integration-failed
    agent_die "Integration verification failed at $worktree"
fi
rebased_commit=$(agent_state_get "$task" verified_commit)
[[ $rebased_commit == "$reviewed_commit" ]] || agent_die 'Approved commit changed during integration verification'
git -C "$AGENT_REPO" merge-base --is-ancestor "$integration_base" "$rebased_commit" || \
    agent_die "$branch is not rebased onto $base_branch"

[[ -z $(git -C "$AGENT_REPO" status --porcelain) ]] || agent_die 'Integration checkout changed during verification'
current_branch=$(git -C "$AGENT_REPO" branch --show-current)
if [[ $current_branch != "$base_branch" || $(git -C "$AGENT_REPO" rev-parse HEAD) != "$integration_base" ]]; then
    agent_state_put "$task" status integration-stale
    agent_die "Integration checkout changed; rebased branch preserved at $worktree"
fi
git -C "$AGENT_REPO" merge --ff-only "$rebased_commit"
[[ $(git -C "$AGENT_REPO" rev-parse HEAD) == "$rebased_commit" ]] || \
    agent_die 'Fast-forward produced an unexpected commit'

agent_state_update "$task" status integrated integrated_commit "$rebased_commit"
printf 'Advanced %s to rebased %s without a merge commit\n' "$base_branch" "$branch"
