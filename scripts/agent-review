#!/usr/bin/env bash

set -euo pipefail

script_dir=$(dirname "$(realpath "$0")")
# shellcheck disable=SC1091
source "$script_dir/agent-common"
agent_init "$script_dir/.."

usage() {
    printf 'Usage: %s [--no-launch | --approve] <task>\n' "${0##*/}"
}

mode=launch
case ${1:-} in
    --no-launch)
        mode=print
        shift
        ;;
    --approve)
        mode=approve
        shift
        ;;
esac
[[ $# -eq 1 ]] || { usage >&2; exit 2; }
task=$1
agent_validate_task "$task"
[[ -f $(agent_state_file "$task") ]] || agent_die "Unknown task: $task"
[[ $(agent_state_get "$task" status) == review ]] || agent_die "Task is not ready for review: $task"

branch=$(agent_state_get "$task" branch)
base=$(agent_state_get "$task" base)
worktree=$(agent_state_get "$task" worktree)
session=$(agent_state_get "$task" session)
task_file=$(agent_state_get "$task" task_file)
verified_commit=$(agent_state_get "$task" verified_commit 2>/dev/null || true)
current_commit=$(git -C "$worktree" rev-parse "$branch")
[[ $verified_commit == "$current_commit" ]] || agent_die "Branch changed after verification; run agent-check $task"

if [[ $mode == approve ]]; then
    agent_state_update "$task" review approved reviewed_commit "$current_commit"
    printf 'Approved review for %s at %s\n' "$task" "$current_commit"
    exit 0
fi

report="$AGENT_STATE_ROOT/reports/$task.md"
prompt_file="$AGENT_STATE_ROOT/reviews/$task-prompt.md"
{
    printf '# Review Assignment\n\n'
    printf 'Review only for behavioral regressions, correctness failures, data loss, unsafe concurrency, and tests that do not exercise the intended behavior. Do not modify files. Report major findings first with file and line references.\n\n'
    printf '## Task Brief\n\n'
    command cat "$task_file"
    printf '\n\n## Completion Report\n\n'
    [[ -f $report ]] && command cat "$report"
    printf '\n\n## Diff\n\n'
    git -C "$worktree" diff --stat "$base..$branch"
    git -C "$worktree" diff "$base..$branch"
} >"$prompt_file"

command cat "$prompt_file"
if [[ $mode == launch ]]; then
    review_window="review-$task"
    agent_window_exists "$session" "$review_window" && agent_die "Review window already exists: $session:$review_window"
    agent_launch_opencode "$session" "$review_window" "$worktree" "$prompt_file"
    agent_state_update "$task" review pending reviewed_commit ''
    agent_state_put "$task" review_window "$review_window"
    printf '\nReview agent: %s:%s\n' "$session" "$review_window"
fi
